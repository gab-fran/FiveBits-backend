# Copie para .env na raiz do backend e preencha os valores locais.
# .env é carregado pela aplicação e pelos scripts administrativos via dotenv.
PORT=3333
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL: o banco deve estar inicializado (consulte infra/init.sql).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fivebits
DB_USER=postgres
DB_PASSWORD=

# Obrigatório: gere um segredo aleatório exclusivo, com pelo menos 32 bytes.
# Exemplo de geração: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Uso pontual: descomente e preencha para npm run create-admin.
# Remova essas variáveis após criar o administrador.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Testes: exporte no shell/CI antes de npm test; o runner NÃO carrega
# estas configurações do .env antes de abrir a conexão de testes.
# O usuário precisa de CREATEDB; use um servidor de desenvolvimento/testes.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=
# TEST_DB_ADMIN=postgres
# PSQL_BIN=psql
